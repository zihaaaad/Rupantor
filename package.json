{
  "name": "zcentre",
  "private": true,
  "version": "1.0.24",
  "description": "Rupantor — desktop font manager and Adobe JSX automation hub for creative workflows.",
  "author": "Zihad Hasan",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder --publish never",
    "release": "tsc -b && vite build && electron-builder --publish always",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.rupantor.app",
    "productName": "Rupantor",
    "artifactName": "${productName}-v${version}-${os}-${arch}-Setup.${ext}",
    "directories": {
      "output": "release/${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "zihaaaad",
      "repo": "Rupantor"
    },
    "files": [
      "dist",
      "dist-electron",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-v${version}-${os}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-v${version}-${os}-${arch}-Portable.${ext}"
    }
  },
  "dependencies": {
    "@types/opentype.js": "^1.3.10",
    "electron-updater": "^6.8.11",
    "font-list": "^2.1.0",
    "lucide-react": "^1.61.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.5"
  }
}
